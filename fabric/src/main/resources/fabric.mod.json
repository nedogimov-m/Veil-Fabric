{
  "schemaVersion": 1,
  "id": "veil",
  "version": "${version}",
  "name": "Veil",
  "description": "Rendering, shaders, particles and native developer tools for Fabric 26.3.",
  "icon": "icon.png",
  "authors": [
    "amo",
    "Cappin",
    "Ocelot"
  ],
  "contributors": [
    "Farcr (Artist)"
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/veil",
    "issues": "https://github.com/FoundryMC/Veil/issues",
    "sources": "https://github.com/FoundryMC/Veil"
  },
  "license": "LGPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": [
      "foundry.veil.fabric.VeilFabric"
    ],
    "client": [
      "foundry.veil.fabric.VeilFabricClient"
    ]
  },
  "mixins": [
    "veil.command.mixins.json",
    "veil.debug.mixins.json",
    "veil.dynamicbuffer.mixins.json",
    "veil.fix.mixins.json",
    "veil.framebuffer.mixins.json",
    "veil.network.mixins.json",
    "veil.necromancer.mixins.json",
    "veil.performance.mixins.json",
    "veil.perspective.mixins.json",
    "veil.pipeline.mixins.json",
    "veil.quasar.mixins.json",
    "veil.registry.mixins.json",
    "veil.rendertype.mixins.json",
    "veil.resource.mixins.json",
    "veil.scheduler.mixins.json",
    "veil.shader.mixins.json",
    "veil.fabric.mixins.json",
    "veil.scene.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": ">=0.163.0+26.3",
    "minecraft": "26.3",
    "java": ">=25"
  },
  "accessWidener": "veil.native.accesswidener"
}
